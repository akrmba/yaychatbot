# ─── Database ─────────────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── Supabase ────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ─── API ──────────────────────────────────────────────────────────
API_URL=
PORT=

# ─── OpenAI / LLM ────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=

# ─── Dashboard (Next.js public) ──────────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WIDGET_URL=

# ─── Vercel ──────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ─── Railway ─────────────────────────────────────────────────────
RAILWAY_TOKEN=

# ─── dotenv-vault ────────────────────────────────────────────────
DOTENV_KEY=

# ─── Integrations ─────────────────────────────────────────────────
# AES-256-GCM key for encrypting OAuth tokens at rest (min 32 chars)
INTEGRATION_ENCRYPTION_KEY=

# App base URL (used for webhook registration callbacks)
APP_BASE_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3001

# Calendly OAuth
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=
CALENDLY_REDIRECT_URI=http://localhost:3000/api/v1/integrations/calendly/callback
CALENDLY_WEBHOOK_SIGNING_KEY=

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/v1/integrations/hubspot/callback

# Slack OAuth (Incoming Webhooks)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/v1/integrations/slack/callback

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# ─── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from your Stripe dashboard
STRIPE_PRICE_STARTER=price_
STRIPE_PRICE_STARTER_OVERAGE=price_
STRIPE_PRICE_GROWTH=price_
STRIPE_PRICE_GROWTH_OVERAGE=price_
STRIPE_PRICE_SCALE=price_
STRIPE_PRICE_SCALE_OVERAGE=price_

# ─── Sentry ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=

# ─── Axiom ────────────────────────────────────────────────────────────
AXIOM_TOKEN=
AXIOM_DATASET=yaychatbot-api

# ─── Cloudflare R2 (widget CDN) ───────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=yaychatbot-widget
# cdn.yaychatbot.com → R2 public bucket custom domain

# ─── Alerting ─��───────────────────────────────────────────────────────
SLACK_DEPLOY_WEBHOOK=

# ─── Railway (production) ─────────────────────────────────────────────
# REDIS_URL is provisioned automatically by Railway
REDIS_URL=
